{
  "name": "@626labs/widget-movie-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Box Office Heads Up + Tag That Line — embeddable movie game widgets for 626labs.dev.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:boxoffice && npm run build:tagline",
    "build:boxoffice": "vite build --mode boxoffice",
    "build:tagline": "vite build --mode tagline",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "terser": "^5.46.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^2.1.8"
  }
}
